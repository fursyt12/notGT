{
	"name": "notGT",
	"version": "0.12.0",
	"private": true,
	"description": "notGT — web titling / animation system for NodeCG. Multi-out broadcast graphics controlled from the dashboard, Bitfocus Companion, plain HTTP or a WebSocket.",
	"license": "MIT",
	"type": "commonjs",
	"nodecg": {
		"compatibleRange": "^2.0.0",
		"dashboardPanels": [
			{
				"name": "control",
				"title": "Control",
				"file": "control.html",
				"fullbleed": true,
				"headerColor": "#0c2b25"
			},
			{
				"name": "titles",
				"title": "Titles & Outs",
				"file": "titles.html",
				"fullbleed": true,
				"headerColor": "#0c2b25"
			},
			{
				"name": "editor",
				"title": "Editor",
				"file": "editor.html",
				"fullbleed": true,
				"headerColor": "#0c2b25"
			},
			{
				"name": "team",
				"title": "Team",
				"file": "team.html",
				"fullbleed": true,
				"headerColor": "#0c2b25"
			}
		],
		"graphics": [
			{
				"file": "out.html",
				"width": 1920,
				"height": 1080,
				"singleInstance": false
			}
		],
		"assetCategories": [
			{
				"name": "media",
				"title": "notGT Media",
				"allowedTypes": [
					"png",
					"jpg",
					"jpeg",
					"gif",
					"webp",
					"svg",
					"mp4",
					"webm",
					"woff",
					"woff2",
					"ttf",
					"otf",
					"json"
				]
			}
		]
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"watch": "node scripts/build.mjs --watch",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test:e2e": "node scripts/e2e-out.mjs && node scripts/e2e-motion.mjs && node scripts/e2e-panels.mjs && node scripts/e2e-excel.mjs && node scripts/e2e-media.mjs && node scripts/e2e-ws.mjs && node scripts/e2e-timers.mjs && node scripts/e2e-ndi.mjs",
		"test:e2e:team": "node scripts/e2e-team.mjs && node scripts/e2e-ws.mjs",
		"convert-alpha": "node scripts/convert-alpha.mjs"
	},
	"devDependencies": {
		"@types/node": "^20.19.0",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@types/ws": "^8.18.2",
		"@vitejs/plugin-react": "^4.3.4",
		"esbuild": "^0.24.0",
		"exceljs": "^4.4.0",
		"konva": "^9.3.16",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-konva": "^18.2.10",
		"typescript": "^5.6.3",
		"vite": "^5.4.11",
		"ws": "^8.22.0"
	}
}
