# ---------------------------------------------------------------------------
# notGT — deployment environment for docker-compose.yml
#
# Copy this file and edit it:
#   cp .env.example .env
#
# Docker Compose reads `.env` from the same directory as docker-compose.yml.
#
# None of these are required for the default setup: `docker compose up --build`
# works with no `.env` at all and serves notGT on port 9090.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# DEFAULT SETUP — a plain published port, no reverse proxy.
# ---------------------------------------------------------------------------

# Host port to publish. The container always listens on 9090, so this only
# decides where the dashboard and the OBS Browser Sources are reachable:
#   http://<host>:${NOTGT_PORT:-9090}/dashboard/
#   http://<host>:${NOTGT_PORT:-9090}/bundles/notGT/graphics/out.html?out=main
NOTGT_PORT=9090

# ---------------------------------------------------------------------------
# SIGN-IN
#
# The dashboard asks for a username and a password. A new server lets
# `admin` / `admin` in: sign in and give the administrator a real password in
# the Team tab — until then anyone who reaches the port knows the way in. The
# other users, their groups and the keys for Companion are made there too.
#
# To name the administrator here instead, set both of these (the default
# `admin` account then goes away). Apply with: docker compose up -d
#
# A password with a `$` in it goes in single quotes, or Compose will try to
# expand it:  NOTGT_LOGIN_PASSWORD='pa$word'
# ---------------------------------------------------------------------------
NOTGT_LOGIN_USER=
NOTGT_LOGIN_PASSWORD=

# NOTGT_LOGIN=off switches the sign-in off altogether: the dashboard opens for
# everyone who can reach the port, the OBS links need no key, and the API is
# open unless the bundle's `apiToken` is set. For a closed show LAN.
#
# OBS cannot sign in: with the sign-in on, the Browser Source links are the
# ones the dashboard shows — each carries the key of its out.
NOTGT_LOGIN=

# Salts the sign-in sessions. Empty = a new one is made up on every start,
# which only means the browser signs itself in again after a restart.
NOTGT_SESSION_SECRET=

# ---------------------------------------------------------------------------
# npm registry mirror (optional, build-time only)
#
# Leave empty to use registry.npmjs.org. The image installs ~1500 packages, and
# on a slow or filtered link a single read timeout in the middle of `npm ci`
# fails the whole build with npm's unhelpful "Exit handler never called!".
# Point it at a mirror if that keeps happening:
#   NPM_REGISTRY=https://registry.npmmirror.com
# ---------------------------------------------------------------------------
NPM_REGISTRY=

# ---------------------------------------------------------------------------
# TRAEFIK (optional)
#
# Only used after uncommenting the TRAEFIK block in docker-compose.yml. Leave
# the values below as they are for the port-only setup — they are ignored.
# ---------------------------------------------------------------------------

# Public hostname Traefik routes to this service (no scheme, no trailing slash).
NOTGT_HOST=notgt.example.com

# Traefik entrypoint that terminates TLS and the certificate resolver to use.
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Name of the pre-existing (external) Traefik Docker network.
TRAEFIK_NETWORK=traefik

# ---------------------------------------------------------------------------
# Basic Auth user list for the dashboard (and, in the default layout, /api).
# Traefik-only: ignored by the port-only setup, where the browser-facing
# surface is protected by the bundle's own `apiToken` (see the bottom of this
# file) or by nothing at all, if that is what you want on a show LAN.
#
# Generate a bcrypt entry with htpasswd (apache2-utils) and escape the `$`
# signs so Docker Compose does not treat them as variable interpolation:
#
#   htpasswd -nbB user pass | sed -e 's/\$/\$\$/g'
#
# e.g. for user `operator` and password `s3cret`:
#   htpasswd -nbB operator 's3cret' | sed -e 's/\$/\$\$/g'
#
# The command prints something like:
#   operator:$2y$05$abcdef....      <- raw htpasswd output
#   operator:$$2y$$05$$abcdef....   <- what you paste below
#
# Multiple users: separate entries with a comma (or run htpasswd -nbB again
# and join the comma-separated results), e.g.
#   NOTGT_BASICAUTH_USERS=alice:$$2y$$05$$...,bob:$$2y$$05$$...
# ---------------------------------------------------------------------------
NOTGT_BASICAUTH_USERS=operator:$$2y$$05$$replace-this-with-a-real-bcrypt-hash

# ---------------------------------------------------------------------------
# The notGT REST API token is NOT configured here. It lives in the bundle
# config, which docker-compose.yml bind mounts into the container:
#
#   cp bundles/notGT/cfg/notGT.example.json \
#      bundles/notGT/cfg/notGT.json
#   # then set a real `apiToken` in it and restart: docker compose restart notgt
#
# With the sign-in on (the default) the API needs this token or a signed-in
# session. With NOTGT_LOGIN=off and an empty `apiToken` the API is OPEN (a
# warning is logged at boot): whoever can reach the machine can drive the show.
# ---------------------------------------------------------------------------
